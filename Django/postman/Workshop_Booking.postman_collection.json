{
	"info": {
		"_postman_id": "workshop-booking-api",
		"name": "Workshop Booking System",
		"description": "Коллекция API для системы бронирования мастер-классов",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api"
		},
		{
			"key": "access_token",
			"value": ""
		},
		{
			"key": "workshop_id",
			"value": "1"
		},
		{
			"key": "booking_id",
			"value": "1"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test('Response has username', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.username).to.eql('testuser');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"test@example.com\",\n    \"password\": \"testpass123\",\n    \"password_confirm\": \"testpass123\"\n}"
						},
						"url": "{{base_url}}/auth/register/"
					}
				},
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Response has access token', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.access).to.be.a('string');",
									"    pm.collectionVariables.set('access_token', json.access);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"testpass123\"\n}"
						},
						"url": "{{base_url}}/auth/login/"
					}
				},
				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var json = pm.response.json();",
									"pm.collectionVariables.set('access_token', json.access);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"adminpass123\"\n}"
						},
						"url": "{{base_url}}/auth/login/"
					}
				},
				{
					"name": "Get Profile",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Response has role', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.role).to.be.oneOf(['admin', 'user']);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{access_token}}"}
						],
						"url": "{{base_url}}/auth/profile/"
					}
				}
			]
		},
		{
			"name": "Workshops",
			"item": [
				{
					"name": "List Workshops",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Response is array', function () {",
									"    pm.expect(pm.response.json()).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{base_url}}/workshops/"
					}
				},
				{
					"name": "Create Workshop (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var json = pm.response.json();",
									"pm.collectionVariables.set('workshop_id', json.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{access_token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Python Masterclass\",\n    \"description\": \"Изучаем Django REST Framework\",\n    \"date\": \"2026-12-15T14:00:00+03:00\",\n    \"capacity\": 10\n}"
						},
						"url": "{{base_url}}/workshops/"
					}
				},
				{
					"name": "Get Workshop Detail",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Response has title', function () {",
									"    pm.expect(pm.response.json().title).to.be.a('string');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{base_url}}/workshops/{{workshop_id}}/"
					}
				},
				{
					"name": "Update Workshop (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{access_token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Python Masterclass Updated\",\n    \"description\": \"Обновлённое описание\",\n    \"date\": \"2026-12-15T14:00:00+03:00\",\n    \"capacity\": 15\n}"
						},
						"url": "{{base_url}}/workshops/{{workshop_id}}/"
					}
				},
				{
					"name": "Delete Workshop (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 204', function () {",
									"    pm.response.to.have.status(204);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [
							{"key": "Authorization", "value": "Bearer {{access_token}}"}
						],
						"url": "{{base_url}}/workshops/{{workshop_id}}/"
					}
				}
			]
		},
		{
			"name": "Bookings",
			"item": [
				{
					"name": "List My Bookings",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Response is array', function () {",
									"    pm.expect(pm.response.json()).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{access_token}}"}
						],
						"url": "{{base_url}}/bookings/"
					}
				},
				{
					"name": "Create Booking",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test('Response includes workshop', function () {",
									"    pm.expect(pm.response.json().workshop).to.be.an('object');",
									"});",
									"var json = pm.response.json();",
									"pm.collectionVariables.set('booking_id', json.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{access_token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"workshop_id\": {{workshop_id}}\n}"
						},
						"url": "{{base_url}}/bookings/"
					}
				},
				{
					"name": "Cancel Booking",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 204', function () {",
									"    pm.response.to.have.status(204);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [
							{"key": "Authorization", "value": "Bearer {{access_token}}"}
						],
						"url": "{{base_url}}/bookings/{{booking_id}}/"
					}
				}
			]
		}
	]
}
