{
	"info": {
		"_postman_id": "workshop-booking-nestjs",
		"name": "Workshop Booking System (NestJS)",
		"description": "Коллекция API для системы бронирования мастер-классов (NestJS)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:3000/api" },
		{ "key": "access_token", "value": "" },
		{ "key": "workshop_id", "value": "1" },
		{ "key": "booking_id", "value": "1" }
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register User",
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
								"pm.test('Response has username', function () { pm.expect(pm.response.json().username).to.eql('testuser'); });"
							],
							"type": "text/javascript"
						}
					}],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"testpass123\",\n  \"password_confirm\": \"testpass123\"\n}" },
						"url": "{{base_url}}/auth/register"
					}
				},
				{
					"name": "Login User",
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
								"var json = pm.response.json();",
								"pm.expect(json.access).to.be.a('string');",
								"pm.collectionVariables.set('access_token', json.access);"
							],
							"type": "text/javascript"
						}
					}],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"testpass123\"\n}" },
						"url": "{{base_url}}/auth/login"
					}
				},
				{
					"name": "Login Admin",
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
								"pm.collectionVariables.set('access_token', pm.response.json().access);"
							],
							"type": "text/javascript"
						}
					}],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"adminpass123\"\n}" },
						"url": "{{base_url}}/auth/login"
					}
				},
				{
					"name": "Get Profile",
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
								"pm.expect(pm.response.json().role).to.be.oneOf(['admin', 'user']);"
							],
							"type": "text/javascript"
						}
					}],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
						"url": "{{base_url}}/auth/profile"
					}
				}
			]
		},
		{
			"name": "Workshops",
			"item": [
				{
					"name": "List Workshops",
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
								"pm.expect(pm.response.json()).to.be.an('array');"
							],
							"type": "text/javascript"
						}
					}],
					"request": { "method": "GET", "url": "{{base_url}}/workshops" }
				},
				{
					"name": "Create Workshop (Admin)",
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
								"pm.collectionVariables.set('workshop_id', pm.response.json().id);"
							],
							"type": "text/javascript"
						}
					}],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"body": { "mode": "raw", "raw": "{\n  \"title\": \"NestJS Masterclass\",\n  \"description\": \"Изучаем NestJS и TypeORM\",\n  \"date\": \"2026-12-15T14:00:00+03:00\",\n  \"capacity\": 10\n}" },
						"url": "{{base_url}}/workshops"
					}
				},
				{
					"name": "Get Workshop Detail",
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
								"pm.expect(pm.response.json().title).to.be.a('string');"
							],
							"type": "text/javascript"
						}
					}],
					"request": { "method": "GET", "url": "{{base_url}}/workshops/{{workshop_id}}" }
				},
				{
					"name": "Update Workshop (Admin)",
					"event": [{
						"listen": "test",
						"script": { "exec": ["pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"], "type": "text/javascript" }
					}],
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"body": { "mode": "raw", "raw": "{\n  \"title\": \"NestJS Masterclass Updated\",\n  \"description\": \"Обновлённое описание\",\n  \"date\": \"2026-12-15T14:00:00+03:00\",\n  \"capacity\": 15\n}" },
						"url": "{{base_url}}/workshops/{{workshop_id}}"
					}
				},
				{
					"name": "Delete Workshop (Admin)",
					"event": [{
						"listen": "test",
						"script": { "exec": ["pm.test('Status code is 204', function () { pm.response.to.have.status(204); });"], "type": "text/javascript" }
					}],
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
						"url": "{{base_url}}/workshops/{{workshop_id}}"
					}
				}
			]
		},
		{
			"name": "Bookings",
			"item": [
				{
					"name": "List My Bookings",
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
								"pm.expect(pm.response.json()).to.be.an('array');"
							],
							"type": "text/javascript"
						}
					}],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
						"url": "{{base_url}}/bookings"
					}
				},
				{
					"name": "Create Booking",
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
								"pm.expect(pm.response.json().workshop).to.be.an('object');",
								"pm.collectionVariables.set('booking_id', pm.response.json().id);"
							],
							"type": "text/javascript"
						}
					}],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{access_token}}" }
						],
						"body": { "mode": "raw", "raw": "{\n  \"workshop_id\": {{workshop_id}}\n}" },
						"url": "{{base_url}}/bookings"
					}
				},
				{
					"name": "Cancel Booking",
					"event": [{
						"listen": "test",
						"script": { "exec": ["pm.test('Status code is 204', function () { pm.response.to.have.status(204); });"], "type": "text/javascript" }
					}],
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
						"url": "{{base_url}}/bookings/{{booking_id}}"
					}
				}
			]
		}
	]
}
